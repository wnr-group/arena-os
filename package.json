{
  "name": "arena-os",
  "version": "0.1.0",
  "private": true,
  "description": "Arena OS — multi-tenant Smart Booking & POS platform",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "expenses:recurring": "tsx scripts/run-recurring-expenses.ts",
    "reports:refresh": "tsx scripts/refresh-reports.ts",
    "billing:dunning": "tsx --import ./scripts/server-only-hook.mjs scripts/run-dunning.ts",
    "_comment:m16": "The M16 suites need BOTH hooks. Two of them additionally drive server actions, which call cookies()/revalidatePath() and therefore need the Next request-runtime stub — run without it they fail 48/61 or die with 'cookies was called outside a request scope', which looks like a product bug and is not one.",
    "test:m16": "npm run test:m16:subscriptions && npm run test:m16:invoices && npm run test:m16:billing && npm run test:m16:dunning && npm run test:m16:authz && npm run test:m16:portal && npm run test:m16:limits && npm run test:m16:grandfather && npm run test:m16:createplan",
    "test:m16:subscriptions": "tsx --import ./scripts/server-only-hook.mjs --import ./scripts/next-runtime-hook.mjs scripts/test-platform-subscriptions.ts",
    "test:m16:invoices": "tsx --import ./scripts/server-only-hook.mjs --import ./scripts/next-runtime-hook.mjs scripts/test-platform-invoices.ts",
    "test:m16:billing": "tsx --import ./scripts/server-only-hook.mjs --import ./scripts/next-runtime-hook.mjs scripts/test-platform-billing.ts",
    "test:m16:dunning": "tsx --import ./scripts/server-only-hook.mjs --import ./scripts/next-runtime-hook.mjs scripts/test-dunning.ts",
    "test:m16:authz": "tsx --import ./scripts/server-only-hook.mjs --import ./scripts/next-runtime-hook.mjs scripts/test-m16-authorization.ts",
    "test:m16:portal": "tsx --import ./scripts/server-only-hook.mjs --import ./scripts/next-runtime-hook.mjs scripts/test-owner-billing-portal.ts",
    "test:m16:limits": "tsx --import ./scripts/server-only-hook.mjs --import ./scripts/next-runtime-hook.mjs scripts/test-m16-limit-race.ts",
    "test:m16:grandfather": "tsx --import ./scripts/server-only-hook.mjs scripts/verify-grandfather-backfill.ts",
    "test:m16:createplan": "tsx --import ./scripts/server-only-hook.mjs --import ./scripts/next-runtime-hook.mjs scripts/verify-admin-create-plan.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.0.2",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "0.344.0",
    "next": "16.2.9",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "2.2.1",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "20.11.24",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.0.0",
    "eslint-config-next": "15.1.3",
    "prettier": "3.2.5",
    "tailwindcss": "4.3.0",
    "tsx": "^4.22.4",
    "typescript": "5.3.3"
  }
}
