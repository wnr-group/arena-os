# ── PostgreSQL ──────────────────────────────────────────────
# Two connections by design, for tenant-isolation integrity.
# Defaults below match the Docker quickstart in README.md (container port 5433,
# passwords from db/bootstrap.sql). Using a native Postgres? Change 5433 → 5432.
#
# DATABASE_URL — the APP connection. Connects as role `arena_app`, which is
#   NOT a superuser and does NOT have BYPASSRLS. Every tenant-facing query runs
#   through it inside a transaction that sets `app.user_id`, so Row-Level
#   Security is always enforced. This is what the running app uses.
DATABASE_URL=postgres://arena_app:arena_app_pw@localhost:5433/arena_os
#
# DATABASE_URL_OWNER — the OWNER connection. Connects as a privileged role that
#   owns the tables and BYPASSES RLS. Used ONLY for migrations, seeding and
#   platform provisioning (tenant signup, session/user lookups). Never used on a
#   tenant data path.
DATABASE_URL_OWNER=postgres://arena_owner:arena_owner_pw@localhost:5433/arena_os

# ── Auth ────────────────────────────────────────────────────
# Secret used to sign the session cookie. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ── App ─────────────────────────────────────────────────────
# Root domain tenants are subdomains of. In local dev use lvh.me:3000
# (lvh.me resolves *.lvh.me to 127.0.0.1, so subdomains work with no setup).
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000

# ── Object storage (S3-compatible) ─────────────────────────

S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_ENDPOINT=your_s3_endpoint
S3_PUBLIC_URL_BASE=your_s3_endpoint/bucket_name

# ── Secret encryption ───────────────────────────────────────
# Master key for application-level encryption of secrets held at rest — today
# the per-tenant Razorpay key secret (lib/security/encryption.ts, AES-256-GCM).
#
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_, never commit a real value,
# and never store it in the database. Without it, saving payment credentials
# fails with a configuration error — there is deliberately no fallback.
#
# Generate: openssl rand -hex 32
# Rotating it makes every previously stored secret undecryptable, so existing
# credentials must be re-entered. The ciphertext format is versioned (`v1:…`)
# so a future migration can re-wrap instead.
PAYMENT_SETTINGS_ENCRYPTION_KEY=

# ── Customer OTP login (M9 / AROS-87) ───────────────────────────
# Phone/OTP sign-in for the customer portal on a tenant subdomain. Entirely
# separate from the staff login above: different table, different cookie.
#
# OTP_DEV_BYPASS — DEVELOPMENT / DEMO / TESTING ONLY.
#   When true, no SMS is sent and the fixed code 123456 is the only code
#   accepted, for any phone number. Everything else about the flow is
#   unchanged: a challenge row is still written, still expires after 5
#   minutes, still counts attempts, and is still single-use.
#
#   The app REFUSES TO START if this is enabled with NODE_ENV=production —
#   lib/otp/config.ts throws at import time rather than logging a warning and
#   carrying on. Leave it unset for any real deployment.
#
#   Accepted true values: 1 / true / yes / on. Anything else means off.
OTP_DEV_BYPASS=true

# MSG91 — the SMS gateway used when OTP_DEV_BYPASS is off. Required in
# production; not needed at all while the bypass is on, so these stay blank in
# a normal dev checkout. Server-only: never prefix with NEXT_PUBLIC_.
#
# MSG91_AUTH_KEY   — account auth key, from MSG91 → Settings → API.
# MSG91_TEMPLATE_ID— the approved DLT OTP template the code is sent through.
# MSG91_SENDER_ID  — optional 6-character DLT sender/header (e.g. ARENA).
#                    Leave blank if the template already fixes the sender.
# MSG91_OTP_EXPIRY_MINUTES — optional, default 5. Kept in step with the
#                    server-side TTL in lib/otp/challenge.ts; the database is
#                    the authority, this only tells MSG91 what to say.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_OTP_EXPIRY_MINUTES=5

# NOTE: the OTP hash is keyed by SESSION_SECRET above (domain-separated — see
# lib/otp/code.ts). A 6-digit code hashed unkeyed would be reversible by
# anyone who read the table, so SESSION_SECRET must be a real random value,
# not the placeholder, for customer login to work at all.
